<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="sqlbrouillon.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2543"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="categories" custom_title="0" dock_id="2" table="4,10:maincategories"/><dock_state state="000000ff00000000fd0000000100000002000002480000020bfc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000000000000000fb000000160064006f0063006b00420072006f00770073006500320100000000000002480000011800ffffff000002480000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE categories (
  id          INTEGER PRIMARY KEY AUTOINCREMENT,
  nom         TEXT    NOT NULL UNIQUE,
  description TEXT
);

CREATE TABLE produits (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  nom          TEXT    NOT NULL,
  prix         REAL    NOT NULL CHECK (prix &gt;= 0),
  quantite     INTEGER NOT NULL DEFAULT 0 CHECK (quantite &gt;= 0),
  disponible   INTEGER NOT NULL DEFAULT 1,   -- 1 = vrai, 0 = faux
  date_ajout   TEXT    NOT NULL,             -- date au format ISO 8601
  categorie_id INTEGER NOT NULL,
  FOREIGN KEY (categorie_id) REFERENCES categories(id) ON DELETE RESTRICT
);
INSERT INTO categories (nom, description) VALUES
  ('Alimentation', 'Produits secs et conserves'),
  ('Boissons',     'Eaux, jus et sodas'),
  ('Hygiène',      'Savons et produits d''entretien'),
  ('Papeterie',    'Cahiers, stylos et fournitures');

INSERT INTO produits (nom, prix, quantite, disponible, date_ajout, categorie_id) VALUES
  ('Huile d''olive 1 L',   18.500,  24, 1, '2026-10-01T09:00:00', 1),
  ('Couscous moyen 1 kg',   2.300,  40, 1, '2026-10-01T09:05:00', 1),
  ('Eau minérale 1,5 L',    0.850, 120, 1, '2026-10-02T10:00:00', 2),
  ('Jus d''orange 1 L',     3.200,   0, 0, '2026-10-02T10:10:00', 2),
  ('Savon de Marseille',    2.900,  15, 1, '2026-10-03T11:00:00', 3),
  ('Cahier 96 pages',       1.600,  60, 1, '2026-10-04T08:30:00', 4);
  -- Q1.5.1 : tous les produits
SELECT * FROM produits;

-- Q1.5.2 : produits en rupture de stock
SELECT * FROM produits WHERE quantite = 0;

-- Q1.5.3 : produits du plus cher au moins cher
SELECT * FROM produits ORDER BY prix DESC;

-- Q1.5.4 : nom de chaque produit avec le nom de sa catégorie
SELECT p.nom AS produit, c.nom AS categorie
FROM produits p
INNER JOIN categories c ON c.id = p.categorie_id;

-- Q1.5.5 : nombre de produits par catégorie
SELECT c.nom AS categorie, COUNT(p.id) AS nb_produits
FROM categories c
LEFT JOIN produits p ON p.categorie_id = c.id
GROUP BY c.id, c.nom;

-- Q1.5.6 : valeur totale du stock
SELECT SUM(prix * quantite) AS valeur_stock FROM produits;
-- a) prix négatif
INSERT INTO produits (nom, prix, quantite, date_ajout, categorie_id)
VALUES ('Test prix', -5, 1, '2026-10-05T08:00:00', 1);

-- b) catégorie qui n'existe pas
INSERT INTO produits (nom, prix, quantite, date_ajout, categorie_id)
VALUES ('Test catégorie', 1, 1, '2026-10-05T08:00:00', 99);

-- c) supprimer une catégorie qui contient des produits
DELETE FROM categories WHERE id = 1;
  </sql><current_tab id="0"/></tab_sql></sqlb_project>
